<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Absence Request Approved</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background-color: #4caf50;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 5px 5px 0 0;
      }
      .content {
        padding: 30px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 0 0 5px 5px;
      }
      .detail-box {
        background-color: white;
        padding: 20px;
        margin: 20px 0;
        border-left: 4px solid #4caf50;
        border-radius: 4px;
      }
      .detail-row {
        display: flex;
        margin: 10px 0;
      }
      .label {
        font-weight: bold;
        width: 140px;
        color: #555;
      }
      .value {
        color: #333;
      }
      .status-badge {
        display: inline-block;
        padding: 5px 15px;
        background-color: #4caf50;
        color: white;
        border-radius: 20px;
        font-size: 14px;
        font-weight: bold;
      }
      .footer {
        text-align: center;
        padding: 20px;
        font-size: 12px;
        color: #777;
      }
    </style>
  </head>
  <body>
    <div class='header'>
      <h1>✓ Absence Request Approved</h1>
    </div>
    <div class='content'>
      <h2>Hello, {{userName}}!</h2>
      <p>Good news! Your absence request has been
        <span class='status-badge'>APPROVED</span></p>

      <div class='detail-box'>
        <h3 style='margin-top: 0;'>Request Details:</h3>
        <div class='detail-row'>
          <span class='label'>Type:</span>
          <span class='value'>{{absenceType}}</span>
        </div>
        <div class='detail-row'>
          <span class='label'>Start Date:</span>
          <span class='value'>{{startDate}}</span>
        </div>
        <div class='detail-row'>
          <span class='label'>End Date:</span>
          <span class='value'>{{endDate}}</span>
        </div>
        <div class='detail-row'>
          <span class='label'>Duration:</span>
          <span class='value'>{{duration}} day(s)</span>
        </div>
        <div class='detail-row'>
          <span class='label'>Reason:</span>
          <span class='value'>{{reason}}</span>
        </div>
        <div class='detail-row'>
          <span class='label'>Remaining Balance:</span>
          <span class='value'>{{remainingBalance}} day(s)</span>
        </div>
      </div>

      <p>Your absence has been recorded in the system. Please make sure to
        coordinate with your team before your leave.</p>
    </div>
    <div class='footer'>
      <p>This is an automated email. Please do not reply to this message.</p>
    </div>
  </body>
</html>